generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            String        @id @default(uuid())
  nombre        String
  apellido      String
  correo        String        @unique
  password      String
  pais          String        @default("Costa Rica")
  ingresos      Ingreso[]
  tarjetas      Tarjeta[]
  suscripciones Suscripcion[]
  gastos        Gasto[]
  pagos         Pago[]        // <-- AGREGADO: Relación bidireccional con Pago
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt
}

model Ingreso {
  id         String   @id @default(uuid())
  nombre     String
  monto      Float
  frecuencia String   @default("Mensual")
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  creadoEn   DateTime @default(now())
}

model Tarjeta {
  id          String        @id @default(uuid())
  nombre      String
  limite      Float         @default(0) // <-- Nuevo campo para el límite de crédito
  deudaActual Float         @default(0)
  diaPago     Int
  usuarioId   String
  usuario     Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pagos       Pago[]
  gastos      Gasto[]
  suscripciones Suscripcion[]
  creadoEn    DateTime      @default(now())
}

model Suscripcion {
  id        String   @id @default(uuid())
  nombre    String
  monto     Float
  diaCobro  Int
  pagadoMes String?
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tarjetaId String?
  tarjeta   Tarjeta? @relation(fields: [tarjetaId], references: [id], onDelete: SetNull)
  pagos     Pago[]
  creadoEn  DateTime @default(now())
}

model Gasto {
  id        String   @id @default(uuid())
  concepto  String
  monto     Float
  categoria String?  @default("General")
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tarjetaId String?
  tarjeta   Tarjeta? @relation(fields: [tarjetaId], references: [id], onDelete: SetNull)
  creadoEn  DateTime @default(now())
}

model Pago {
  id            String       @id @default(uuid())
  concepto      String
  monto         Float
  categoria     String?      @default("General")
  usuarioId     String
  usuario       Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tarjetaId     String?
  tarjeta       Tarjeta?     @relation(fields: [tarjetaId], references: [id], onDelete: SetNull)
  suscripcionId String?
  suscripcion   Suscripcion? @relation(fields: [suscripcionId], references: [id], onDelete: SetNull)
  creadoEn      DateTime     @default(now())
}